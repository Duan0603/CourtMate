{
  "name": "courtmate-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run web:dev\"",
    "backend:dev": "npm run start:dev --prefix apps/backend",
    "frontend:dev": "npm run start --prefix apps/frontend",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migration": "npm run migrate:up --prefix apps/backend",
    "migration:status": "npm run migrate:status --prefix apps/backend",
    "migration:down": "npm run migrate:down --prefix apps/backend",
    "migration:create": "npm run migrate:create --prefix apps/backend",
    "build": "npm run build --prefix packages/shared && npm run build --prefix apps/backend && npm run build --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web && npm run typecheck --prefix apps/backend"
  },
  "overrides": {
    "@types/react": "~18.2.45",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "@react-native/virtualized-lists": "0.74.87"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
