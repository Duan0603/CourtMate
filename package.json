{
  "name": "courtmate-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend:dev": "npm run start:dev --prefix apps/backend",
    "frontend:dev": "npm run start --prefix apps/frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migration": "npm run migrate:up --prefix apps/backend",
    "migration:status": "npm run migrate:status --prefix apps/backend",
    "migration:down": "npm run migrate:down --prefix apps/backend",
    "migration:create": "npm run migrate:create --prefix apps/backend",
    "typecheck": "npm run typecheck --prefix apps/frontend && npm run typecheck --prefix apps/backend"
  }
}
