{
  "expo": {
    "name": "CourtMate",
    "slug": "courtmate-frontend",
    "version": "1.0.0",
    "scheme": "courtmate",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CourtMate cần quyền truy cập thư viện để tải banner giải đấu và ảnh đại diện."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
