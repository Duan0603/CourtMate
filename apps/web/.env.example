# CourtMate Web Environment Configuration

# Backend REST API endpoint (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket / Socket.IO real-time chat endpoint
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Google OAuth 2.0 Web Client ID (From Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application Port for local development
PORT=3001

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
